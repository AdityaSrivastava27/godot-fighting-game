; -----------------------------------------------------------------------------
;  HEAD
;  Head pivot is the atlas joint at y = 2.26, so rotating Head alone turns the
;  skull on the neck the way it should. Chin lands at 2.19 and the spikes top
;  out at 2.58 - about 7.4 heads, the usual fighting-game read.
;
;  Depth order out from the skull surface matters more than any single number
;  here: brow ridge is proud of the skull, eyebrows are proud of the brow,
;  and the iris is proud of the eyeball. Break that order and the face caves
;  in under the stage spots.
; -----------------------------------------------------------------------------

[node name="Neck" type="Node3D" parent="Rig/Hips/Spine/Chest"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.3, 0)

[node name="NeckMesh" type="MeshInstance3D" parent="Rig/Hips/Spine/Chest/Neck"]
