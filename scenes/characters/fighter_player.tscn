[ext_resource type="Material" path="res://materials/characters/accent_cyan.tres" id="6_accent"]
[ext_resource type="Material" path="res://materials/characters/eye_white.tres" id="7_eyew"]
[ext_resource type="Material" path="res://materials/characters/eye_dark.tres" id="8_eyed"]

