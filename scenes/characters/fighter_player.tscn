[gd_scene format=3]

; =============================================================================
;  KESTREL - player fighter
; =============================================================================
;  Lean, fast archetype. 2.58 units crown-to-sole, ~7.4 heads.
;
;  ARENA SCALE. The arena is not authored at 1 unit = 1 metre. Crates are 1.2,
;  step risers 0.4, corner posts ~2.1 and CloseCamera sits at y = 2.6, which
;  all triangulate to roughly 1 unit = 0.68 m. 2.58 units is therefore a
;  1.75 m fighter. Getting this wrong is the one error that cannot be fixed
;  later by tweaking a material.
;
;  LOCAL AXES. The fighter faces -Z, Godot's forward. That makes +X the
;  character's own right, which is what the _R / _L suffixes mean throughout.
;  The arena instance yaws the whole scene to aim it down the fight axis.
;
;  THE RIG. Every joint is a bare Node3D placed at its anatomical centre of
;  rotation; the MeshInstance3Ds underneath it are offset so the joint itself
;  stays at the pivot. An AnimationPlayer only ever has to rotate the Node3Ds
;  - no mesh needs to move - which is what makes stances, strikes and hit
;  reactions authorable later without touching this file.
;
;    Hips -> Spine -> Chest -> Neck -> Head
;                  -> Shoulder_* -> UpperArm_* -> LowerArm_* -> Hand_*
;                                   -> Thumb/Index/Middle/Ring/Little (2 each)
;         -> UpperLeg_* -> LowerLeg_* -> Foot_* -> Toe_*
;
;  Bind pose is a shallow A-pose: the arms carry a 9 degree outward tilt so the
;  forearms clear the thighs. Everything else is neutral and symmetric.
;
;  No gameplay here - this scene is geometry and nothing else. No script, no
;  physics body, no collision shape.
; =============================================================================

[ext_resource type="Material" path="res://materials/characters/skin_player.tres" id="1_skin"]
[ext_resource type="Material" path="res://materials/characters/hair_player.tres" id="2_hair"]
[ext_resource type="Material" path="res://materials/characters/cloth_blue.tres" id="3_gi"]
[ext_resource type="Material" path="res://materials/characters/cloth_blue_dark.tres" id="4_dark"]
