[gd_scene format=3]

; =============================================================================
;  IRONJAW - CPU fighter
; =============================================================================
;  Heavy grappler archetype, and the deliberate opposite of Kestrel on every
;  axis a player reads at a glance:
;
;                     Kestrel (player)        Ironjaw (CPU)
;    height           2.51 crown / 2.58 hair  2.72 crown / 2.83 topknot
;    build            lean, narrow shoulders  broad, shoulder-heavy
;    hue              cool blue + cyan        warm crimson + ember
;    skin             light tan               deep brown-grey, half the value
;    head             spiked black hair       bald, crimson topknot, beard
;    silhouette break spikes, loose band      one huge asymmetric pauldron
;    feet             barefoot, wrapped       heavy plated boots
;
;  Same 1 unit ~ 0.68 m arena scale and the same -Z facing as Kestrel, so the
;  two scenes drop into the arena the same way. Same rig contract too: every
;  joint is a bare Node3D at its centre of rotation, meshes hang off it.
;
;  TRANSFORM3D IS ROW-MAJOR. The twelve floats of a .tscn transform are
;  rows[0], rows[1], rows[2], origin - NOT the three basis axes. The axis a
;  local direction maps to is a COLUMN: local +X -> (f1, f4, f7), +Y ->
;  (f2, f5, f8), +Z -> (f3, f6, f9). Write the axes straight across instead
;  and you store the transpose, which for a rotation is its inverse, so every
;  angle comes out silently negated. Verify a rotation by reading the column:
;  this scene's faces must give local +Z a positive z, so forward points -Z.
;
;    Hips -> Spine -> Chest -> Neck -> Head
;                  -> Shoulder_* -> UpperArm_* -> LowerArm_* -> Hand_*
;                                   -> Thumb/Index/Middle/Ring/Little (2 each)
;         -> UpperLeg_* -> LowerLeg_* -> Foot_* -> Toe_*
;
;  Bind pose carries an 11 degree arm splay - two degrees wider than Kestrel,
;  because this torso is wider and the forearms have more thigh to clear.
;
;  Geometry only. No script, no physics body, no collision shape, no AI - the
;  "CPU" in the name is which side of the arena it stands on, nothing more.
; =============================================================================

[ext_resource type="Material" path="res://materials/characters/skin_cpu.tres" id="1_skin"]
[ext_resource type="Material" path="res://materials/characters/hair_cpu.tres" id="2_hair"]
[ext_resource type="Material" path="res://materials/characters/cloth_crimson.tres" id="3_cloth"]
[ext_resource type="Material" path="res://materials/characters/leather_dark.tres" id="4_leather"]
[ext_resource type="Material" path="res://materials/characters/armor_iron.tres" id="5_iron"]
[ext_resource type="Material" path="res://materials/characters/accent_ember.tres" id="6_ember"]
[ext_resource type="Material" path="res://materials/characters/eye_white.tres" id="7_eyew"]
[ext_resource type="Material" path="res://materials/characters/eye_dark.tres" id="8_eyed"]

