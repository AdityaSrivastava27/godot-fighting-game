; opposite the pauldron, so whichever side of Ironjaw the camera is on there
; is an ember accent somewhere in frame.

[sub_resource type="BoxMesh" id="Mesh_scar"]
material = ExtResource("6_ember")
size = Vector3(0.018, 0.115, 0.02)

; =============================================================================
;  RIG
;  Joint heights above the sole, in units:
;    ankle 0.14  knee 0.84  hip 1.46  spine 1.66  chest 1.94
;    shoulder 2.27  elbow 1.74  wrist 1.33  neck 2.30  head 2.46  crown 2.72
;  Elbow and wrist are quoted before the bind-pose arm splay, which lifts them
;  about a centimetre. Every one is above Kestrel's matching joint, so the two
;  fighters differ in stature at the skeleton, not just in mesh thickness.
; =============================================================================

[node name="FighterCpu" type="Node3D"]

