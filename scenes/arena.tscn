[gd_scene format=3]

; =============================================================================
;  DUSK COLOSSEUM - 3D fighting game arena
; =============================================================================
;  Axis convention
;    +X / -X .. the fight axis. Playable range is X = -13 .. +13.
;    Z = 0 ..... the fight plane. Fighters stand here; the camera looks up +Z.
;    Y = 0 ..... the walking surface of the platform.
;
;  Readability contract (this is what keeps two fighters legible):
;    - Platform is mid-value and desaturated; everything behind it is dark.
;    - Two overhead spots pool light on the playfield only.
;    - A cool directional rim light from behind separates silhouettes.
;    - Depth fog starts at 26 units, so the background reads as flat value.
;
;  Nothing here moves gameplay state. The only scripts are fire flicker and
;  banner sway, both cosmetic.
; =============================================================================

[ext_resource type="Environment" path="res://environment/arena_env.tres" id="1_env"]
[ext_resource type="CameraAttributesPractical" path="res://environment/arena_camera_attributes.tres" id="2_camattr"]
[ext_resource type="Material" path="res://materials/floor_stone.tres" id="3_floor"]
[ext_resource type="Material" path="res://materials/platform_slab.tres" id="4_slab"]
[ext_resource type="Material" path="res://materials/stone_light.tres" id="5_stonelight"]
[ext_resource type="Material" path="res://materials/stone_dark.tres" id="6_stonedark"]
[ext_resource type="Material" path="res://materials/metal_dark.tres" id="7_metal"]
[ext_resource type="Material" path="res://materials/bronze_trim.tres" id="8_bronze"]
[ext_resource type="Material" path="res://materials/glow_boundary.tres" id="9_glow"]
[ext_resource type="Material" path="res://materials/glow_warm.tres" id="10_warm"]
[ext_resource type="Material" path="res://materials/ember_coals.tres" id="11_ember"]
[ext_resource type="Material" path="res://materials/pit_dark.tres" id="12_pit"]
[ext_resource type="Material" path="res://materials/banner_red.tres" id="13_red"]
[ext_resource type="Material" path="res://materials/banner_blue.tres" id="14_blue"]
[ext_resource type="Material" path="res://materials/soft_dot_additive.tres" id="15_dot"]
[ext_resource type="Material" path="res://materials/mist_soft.tres" id="16_mist"]
[ext_resource type="Material" path="res://materials/city_silhouette.tres" id="24_city"]
[ext_resource type="Material" path="res://materials/floor_medallion.tres" id="25_medallion"]
[ext_resource type="PackedScene" path="res://scenes/props/brazier.tscn" id="17_brazier"]
[ext_resource type="PackedScene" path="res://scenes/props/pillar.tscn" id="18_pillar"]
[ext_resource type="PackedScene" path="res://scenes/props/banner.tscn" id="19_banner"]
[ext_resource type="PackedScene" path="res://scenes/props/lantern.tscn" id="20_lantern"]
[ext_resource type="PackedScene" path="res://scenes/props/crate.tscn" id="21_crate"]
[ext_resource type="PackedScene" path="res://scenes/props/barrel.tscn" id="22_barrel"]
[ext_resource type="PackedScene" path="res://scenes/props/rubble.tscn" id="23_rubble"]

; Two shared primitives do nearly all the work. Every block below is the same
; unit cube or unit cylinder scaled by its node transform, and the stone
; materials use world-space triplanar UVs so the texture scale stays constant
; no matter how a block is stretched.

[sub_resource type="BoxMesh" id="Mesh_box"]
size = Vector3(1, 1, 1)

[sub_resource type="CylinderMesh" id="Mesh_cyl"]
top_radius = 0.5
bottom_radius = 0.5
height = 1.0
radial_segments = 16
rings = 1

[sub_resource type="TorusMesh" id="Mesh_ring"]
inner_radius = 3.3
outer_radius = 3.62
rings = 48
ring_segments = 6

[sub_resource type="QuadMesh" id="Mesh_mote"]
size = Vector2(0.07, 0.07)

[sub_resource type="QuadMesh" id="Mesh_mistpuff"]
size = Vector2(11, 11)

[sub_resource type="Gradient" id="Grad_mote"]
offsets = PackedFloat32Array(0, 0.25, 0.75, 1)
colors = PackedColorArray(0.7, 0.82, 1, 0, 0.75, 0.85, 1, 0.3, 0.75, 0.85, 1, 0.22, 0.7, 0.82, 1, 0)

[sub_resource type="Gradient" id="Grad_mist"]
offsets = PackedFloat32Array(0, 0.3, 0.7, 1)
colors = PackedColorArray(0.4, 0.48, 0.68, 0, 0.44, 0.52, 0.72, 0.2, 0.44, 0.52, 0.72, 0.16, 0.4, 0.48, 0.68, 0)

[sub_resource type="BoxShape3D" id="Shape_floor"]
size = Vector3(30, 1.58, 18)

[sub_resource type="BoxShape3D" id="Shape_wall_x"]
size = Vector3(0.6, 9, 15)

[sub_resource type="BoxShape3D" id="Shape_wall_z"]
size = Vector3(26.7, 9, 0.6)

[sub_resource type="BoxShape3D" id="Shape_terrace"]
size = Vector3(86, 1.4, 11)

[node name="Arena" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = ExtResource("1_env")
camera_attributes = ExtResource("2_camattr")

; -----------------------------------------------------------------------------
;  LIGHTING
;  Three directionals form the classic key / fill / rim triangle, and two
;  overhead spots pool extra light on the playfield so fighters are always the
;  brightest thing on screen.
; -----------------------------------------------------------------------------

[node name="Lighting" type="Node3D" parent="."]

[node name="KeyLight" type="DirectionalLight3D" parent="Lighting"]
transform = Transform3D(-0.8192, 0, 0.5736, 0.4563, 0.606, 0.6517, -0.3476, 0.7955, -0.4964, 0, 26, -14)
light_color = Color(1, 0.89, 0.78, 1)
light_energy = 1.15
light_specular = 0.5
light_angular_distance = 1.2
shadow_enabled = true
shadow_bias = 0.04
shadow_normal_bias = 1.4
directional_shadow_mode = 2
directional_shadow_split_1 = 0.06
directional_shadow_split_2 = 0.16
directional_shadow_split_3 = 0.42
directional_shadow_blend_splits = true
directional_shadow_fade_start = 0.9
directional_shadow_max_distance = 70.0

[node name="FillLight" type="DirectionalLight3D" parent="Lighting"]
transform = Transform3D(0.8141, 0, -0.5807, -0.2947, 0.8616, -0.4132, 0.5004, 0.5075, 0.7014, 0, 22, 18)
light_color = Color(0.45, 0.58, 0.95, 1)
light_energy = 0.4
light_specular = 0.2
shadow_enabled = false

[node name="RimLight" type="DirectionalLight3D" parent="Lighting"]
transform = Transform3D(1, 0, 0, 0, 0.9367, -0.3502, 0, 0.3502, 0.9367, 0, 14, 22)
light_color = Color(0.58, 0.83, 1, 1)
light_energy = 0.55
light_specular = 0.7
shadow_enabled = false

[node name="StageSpotLeft" type="SpotLight3D" parent="Lighting"]
transform = Transform3D(1, 0, 0, 0, 0.10453, -0.99452, 0, 0.99452, 0.10453, -6.5, 13.5, -1)
light_color = Color(1, 0.96, 0.9, 1)
light_energy = 1.7
light_specular = 0.6
shadow_enabled = true
shadow_bias = 0.05
shadow_normal_bias = 1.2
spot_range = 27.0
spot_attenuation = 1.1
spot_angle = 47.0
spot_angle_attenuation = 0.85

[node name="StageSpotRight" type="SpotLight3D" parent="Lighting"]
transform = Transform3D(1, 0, 0, 0, 0.10453, -0.99452, 0, 0.99452, 0.10453, 6.5, 13.5, -1)
light_color = Color(1, 0.96, 0.9, 1)
light_energy = 1.7
light_specular = 0.6
shadow_enabled = true
shadow_bias = 0.05
shadow_normal_bias = 1.2
spot_range = 27.0
spot_attenuation = 1.1
spot_angle = 47.0
spot_angle_attenuation = 0.85

[node name="ChasmGlow" type="OmniLight3D" parent="Lighting"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -6.5, 16)
light_color = Color(1, 0.42, 0.14, 1)
light_energy = 2.8
light_specular = 0.2
shadow_enabled = false
omni_range = 36.0
omni_attenuation = 1.4

; -----------------------------------------------------------------------------
;  CAMERAS
;  MainCamera frames the entire playable area - the widest a tracking camera
;  would ever need to pull back. CloseCamera is round-start distance, and
;  WideCamera takes in the whole set for screenshots. Only MainCamera is current.
; -----------------------------------------------------------------------------

[node name="MainCamera" type="Camera3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 0.98163, 0.19081, 0, 0.19081, -0.98163, 0, 6, -19)
attributes = ExtResource("2_camattr")
current = true
fov = 45.0
near = 0.1
far = 300.0

[node name="WideCamera" type="Camera3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 0.98571, 0.16853, 0, 0.16853, -0.98571, 0, 9, -34)
attributes = ExtResource("2_camattr")
current = false
fov = 45.0
near = 0.1
far = 400.0

[node name="CloseCamera" type="Camera3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 0.98777, 0.15592, 0, 0.15592, -0.98777, 0, 2.6, -9.5)
attributes = ExtResource("2_camattr")
current = false
fov = 45.0
near = 0.1
far = 300.0

; -----------------------------------------------------------------------------
;  PLATFORM
;  Slab 30 x 18 with a 27 x 15 fight surface inlaid flush at Y = 0.
;  The bronze rim sits on the 1.5-unit margin outside the playable area, and
;  the front rim is deliberately half the height of the other three so it can
;  never crop a fighters feet from the match camera.
; -----------------------------------------------------------------------------

[node name="Platform" type="Node3D" parent="."]

[node name="Slab" type="MeshInstance3D" parent="Platform"]
transform = Transform3D(30, 0, 0, 0, 1.5, 0, 0, 0, 18, 0, -0.83, 0)
mesh = SubResource("Mesh_box")
material_override = ExtResource("4_slab")

