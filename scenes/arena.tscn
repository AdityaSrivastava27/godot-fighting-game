; -----------------------------------------------------------------------------
;  BACKGROUND
;  Four depth layers, each darker than the one in front of it:
;    1. the chasm the platform is suspended over  (Z 10 .. 15, Y -10)
;    2. the terrace and its colonnade             (Z 15 .. 26)
;    3. the arcaded back wall                     (Z 28)
;    4. the city silhouette beyond                (Z 44 .. 92, in heavy fog)
;  Nothing in here casts shadows - the shadow budget is spent on the platform.
; -----------------------------------------------------------------------------

[node name="Background" type="Node3D" parent="."]

[node name="Chasm" type="Node3D" parent="Background"]

[node name="PitFloor" type="MeshInstance3D" parent="Background/Chasm"]
transform = Transform3D(150, 0, 0, 0, 1, 0, 0, 0, 150, 0, -10.5, 20)
cast_shadow = 0
mesh = SubResource("Mesh_box")
material_override = ExtResource("12_pit")

