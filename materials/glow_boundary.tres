[gd_resource type="StandardMaterial3D" format=3]

; Inlaid ring-out boundary line. Unshaded so it holds the same brightness
; regardless of which light hits it. Bright enough to bloom slightly, dim
; enough that it never out-reads a fighter standing next to it.

[resource]
resource_name = "GlowBoundary"
shading_mode = 0
albedo_color = Color(0.26, 0.66, 0.84, 1)
emission_enabled = true
emission = Color(0.24, 0.66, 0.88, 1)
emission_energy_multiplier = 1.4
