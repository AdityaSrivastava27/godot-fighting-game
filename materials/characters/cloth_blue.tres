[gd_resource type="StandardMaterial3D" format=3]

; Kestrel's gi. Deliberately well above banner_blue (0.055, 0.085, 0.24) in
; both value and chroma - the banners hang directly behind the fighters and
; were authored low precisely so a character could sit in front of them.
;
; Weave noise runs through a narrow 0.82 -> 1.0 ramp, the same discipline
; floor_stone uses: enough to break up a flat block, never enough to read as
; pattern at match-camera distance.

[sub_resource type="FastNoiseLite" id="Noise_weave"]
noise_type = 3
seed = 12
frequency = 1.6
fractal_octaves = 2

[sub_resource type="Gradient" id="Ramp_weave"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(0.82, 0.82, 0.82, 1, 1, 1, 1, 1)

[sub_resource type="NoiseTexture2D" id="Tex_weave"]
width = 128
height = 128
seamless = true
color_ramp = SubResource("Ramp_weave")
noise = SubResource("Noise_weave")

[sub_resource type="NoiseTexture2D" id="Tex_weave_n"]
width = 128
height = 128
seamless = true
as_normal_map = true
bump_strength = 1.1
noise = SubResource("Noise_weave")

[resource]
resource_name = "ClothBlue"
albedo_color = Color(0.078, 0.215, 0.47, 1)
albedo_texture = SubResource("Tex_weave")
metallic = 0.0
metallic_specular = 0.2
roughness = 0.86
normal_enabled = true
normal_scale = 0.4
normal_texture = SubResource("Tex_weave_n")
uv1_scale = Vector3(1.8, 1.8, 1.8)
uv1_triplanar = true
uv1_world_triplanar = false
