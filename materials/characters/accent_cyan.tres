[gd_resource type="StandardMaterial3D" format=3]

; Kestrel's team accent: headband, gi piping, bicep band, back emblem.
; Faintly emissive so it survives the dark side of the key light and gives
; the player a consistent cool tell from any angle. Energy is low on purpose
; - this is a tint, not a light source.

[resource]
resource_name = "AccentCyan"
albedo_color = Color(0.11, 0.63, 0.73, 1)
metallic = 0.0
metallic_specular = 0.45
roughness = 0.45
emission_enabled = true
emission = Color(0.12, 0.7, 0.85, 1)
emission_energy_multiplier = 0.32
