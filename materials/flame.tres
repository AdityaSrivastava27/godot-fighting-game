[gd_resource type="StandardMaterial3D" format=3]

; Additive stylised flame cone.
;
; The gradient runs along the cone from base to tip and drops to zero alpha at
; both ends, which is what stops an untextured additive cone from reading as a
; hard-edged solid pyramid. Albedo is deliberately over 1.0 so the core pushes
; past the glow threshold and blooms.

[sub_resource type="Gradient" id="Grad_flame"]
offsets = PackedFloat32Array(0, 0.22, 0.6, 1)
colors = PackedColorArray(0.9, 0.24, 0.05, 0, 1, 0.45, 0.12, 0.62, 1, 0.78, 0.4, 0.7, 1, 0.95, 0.75, 0)

[sub_resource type="GradientTexture2D" id="Tex_flame"]
gradient = SubResource("Grad_flame")
width = 8
height = 128
fill_from = Vector2(0.5, 1)
fill_to = Vector2(0.5, 0)

[resource]
resource_name = "Flame"
transparency = 1
blend_mode = 1
shading_mode = 0
cull_mode = 2
albedo_color = Color(1.6, 1.05, 0.5, 0.9)
albedo_texture = SubResource("Tex_flame")
disable_receive_shadows = true
