[gd_resource type="StandardMaterial3D" format=3]

; Soft round sprite built from a radial GradientTexture2D, so embers and dust
; render as glowing dots instead of visible quads. Generated at load time -
; no image files to import.

[sub_resource type="Gradient" id="Grad_dot"]
offsets = PackedFloat32Array(0, 0.35, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0.55, 1, 1, 1, 0)

[sub_resource type="GradientTexture2D" id="Tex_dot"]
gradient = SubResource("Grad_dot")
width = 64
height = 64
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

[resource]
resource_name = "SoftDotAdditive"
transparency = 1
blend_mode = 1
shading_mode = 0
vertex_color_use_as_albedo = true
albedo_color = Color(1, 1, 1, 1)
albedo_texture = SubResource("Tex_dot")
billboard_mode = 3
billboard_keep_scale = true
disable_receive_shadows = true
