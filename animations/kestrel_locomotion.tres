; ---------------------------------------------------------------------------
;  The library. It is mounted under the empty name on Kestrel's
;  AnimationPlayer, so these are addressed as "idle", "walk_forward" and
;  so on, with no library prefix.
; ---------------------------------------------------------------------------
[resource]
_data = {
"idle": SubResource("Anim_idle"),
"walk_forward": SubResource("Anim_walk_forward"),
"walk_back": SubResource("Anim_walk_back"),
"hop_left": SubResource("Anim_hop_left"),
"hop_right": SubResource("Anim_hop_right")
}
